# REDUTAX environment variables — placeholders only.
# Copy to .env and fill in real values. Never commit .env.

# App
REDUTAX_ENV=development            # development | test | production
REDUTAX_LOG_LEVEL=INFO
REDUTAX_CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml defaults for local development)
DATABASE_URL=postgresql+psycopg://redutax:redutax@localhost:5432/redutax

# Neon (hosted PostgreSQL) instead of Docker — placeholders, use your own values:
#   prefix postgresql+psycopg:// (not postgresql://) and keep ?sslmode=require
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<main-branch-host>.neon.tech/<database>?sslmode=require

# PostgreSQL tests (pytest). A SERVER URL on a separate test database/branch — the tests create
# and drop their own throwaway databases there. Never the main/production database.
# TEST_PSQL_URL=postgresql+psycopg://redutax:redutax@localhost:5432/postgres
# TEST_PSQL_URL=postgresql+psycopg://<user>:<password>@<test-branch-host>.neon.tech/<database>?sslmode=require

# --- Phase 2 providers: leave empty until the team approves each provider (paid APIs) ---
# Model & price registry (Features 4 and 7). Default: config/models.yaml (ships empty).
# REDUTAX_MODELS_REGISTRY=config/models.yaml

# Server speech-to-text (Feature 8) - any OpenAI-compatible /audio/transcriptions endpoint.
# STT_BASE_URL=https://<stt-provider-host>/v1
# STT_API_KEY=
# STT_MODEL=<stt-model-name>

# Chat LLM (Feature 9) - any OpenAI-compatible /chat/completions endpoint.
# Without these, /api/chat works in analysis mode only and /send returns 503 llm_not_configured.
# LLM_BASE_URL=https://<llm-provider-host>/v1
# LLM_API_KEY=
# LLM_MODEL=<llm-model-name>
# LLM_PROVIDER_NAME=<display name>
# LLM_TIMEOUT_SECONDS=30

# Vapi telephone webhook (Feature 10). With no secret set, POST /api/vapi/webhook refuses all
# requests (503). See docs/VAPI_FINAL_CONNECTION_GUIDE.md.
# VAPI_WEBHOOK_SECRET=
# VAPI_HMAC_SECRET=
# VAPI_HMAC_SIGNATURE_HEADER=x-signature
# VAPI_HMAC_TIMESTAMP_HEADER=x-timestamp
# VAPI_TOOL_TIMEOUT_SECONDS=8
# The Vapi private API key is used only from your own terminal/dashboard to create the
# assistant; the backend does not read it.
# VAPI_API_KEY=
