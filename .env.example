# REDUTAX environment variables — placeholders only.
# Copy to .env and fill in real values. Never commit .env.

# App
REDUTAX_ENV=development            # development | test | production
REDUTAX_LOG_LEVEL=INFO
REDUTAX_CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml defaults for local development)
DATABASE_URL=postgresql+psycopg://redutax:redutax@localhost:5432/redutax

# Neon (hosted PostgreSQL) instead of Docker — placeholders, use your own values:
#   prefix postgresql+psycopg:// (not postgresql://) and keep ?sslmode=require
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<main-branch-host>.neon.tech/<database>?sslmode=require

# PostgreSQL tests (pytest). A SERVER URL on a separate test database/branch — the tests create
# and drop their own throwaway databases there. Never the main/production database.
# TEST_PSQL_URL=postgresql+psycopg://redutax:redutax@localhost:5432/postgres
# TEST_PSQL_URL=postgresql+psycopg://<user>:<password>@<test-branch-host>.neon.tech/<database>?sslmode=require

# --- Later phases: leave empty until the team approves each provider ---
# LLM providers (Phase 3/4)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

# Vapi telephone integration (Phase 5)
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
