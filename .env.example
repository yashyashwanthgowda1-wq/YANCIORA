# REDUTAX environment variables — placeholders only.
# Copy to .env and fill in real values. Never commit .env.

# App
REDUTAX_ENV=development            # development | test | production
REDUTAX_LOG_LEVEL=INFO
REDUTAX_CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml defaults for local development)
DATABASE_URL=postgresql+psycopg://redutax:redutax@localhost:5432/redutax

# --- Later phases: leave empty until the team approves each provider ---
# LLM providers (Phase 3/4)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

# Vapi telephone integration (Phase 5)
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
